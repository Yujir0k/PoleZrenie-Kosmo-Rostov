# Общие настройки
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
PUBLIC_ORIGIN=http://localhost:3001

# PostgreSQL / Redis
POSTGRES_DB=vegetation
POSTGRES_USER=vegetation
POSTGRES_PASSWORD=vegetation
DATABASE_URL=postgresql+asyncpg://vegetation:vegetation@postgres:5432/vegetation
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
TILE_CACHE_URL=redis://redis:6379/2
TILE_CACHE_TTL_SECONDS=9000
USE_CELERY=true

# Google Earth Engine. JSON-файл не добавлять в Git.
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_FILE=/run/secrets/gee-service-account.json
HISTORY_YEARS=6
ANALYSIS_ADAPTER=app.analysis:PoleZrenieAnalysisAdapter

# Copernicus Data Space OAuth
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ERA5-Land доступен через Google Earth Engine и отдельного ключа не требует.

# Резервный публичный узел для временных сбоев основного Overpass.
OVERPASS_FALLBACK_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter

# AI-помощник. Секретный ключ хранится только здесь и никогда не попадает в браузер.
# Создать ключ: Yandex AI Studio → «Создать API-ключ».
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_CHAT_MODEL=aliceai-llm-flash
YANDEX_REPORT_MODEL=yandexgpt-5.1
YANDEX_VISION_MODEL=qwen3.6-35b-a3b
YANDEX_AI_TIMEOUT_SECONDS=55
YANDEX_AI_DISABLE_LOGGING=true
